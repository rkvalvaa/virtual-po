{
  "regions": ["fra1"],
  "buildCommand": "sh scripts/vercel-build.sh",
  "crons": [
    {
      "path": "/api/cron/webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/teams",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/review-cycles",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/tracker-status-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/tracker-delivery",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/blob-cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}

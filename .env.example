# =============================================================================
# Virtual Product Owner — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Required variables are marked with (required).

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/vpo

# Auth.js v5 / NextAuth (required)
AUTH_SECRET=                    # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true

# OAuth Providers (at least one required)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic AI (required for agents)
ANTHROPIC_API_KEY=
AI_BUDGET_MAX_MONTHLY_USD=

# =============================================================================
# Integrations (all optional)
# =============================================================================

# Jira — Connect via Settings > Jira tab (credentials stored in DB)
# No env vars needed; configured through the UI.

# Linear — Connect via Settings > Linear tab (credentials stored in DB)
# No env vars needed; configured through the UI.

# GitHub Issues — Uses GitHub OAuth token from auth provider.
# No additional env vars needed; configured through the UI.

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=               # xoxb-... (from Slack app settings). App must have the users:read.email scope for approve/reject buttons.

# File attachments — Vercel Blob (private store)
# Vercel sets this automatically once a Blob store is connected to the project.
# Set it manually for local dev or self-hosting. Unset, uploads are rejected
# with "File storage is not configured" and existing attachments 404.
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# Optional Configuration
# =============================================================================

# Postgres pool, per function instance (defaults tuned for serverless)
# DB_POOL_MAX=5
# DB_POOL_IDLE_MS=10000
# DB_POOL_CONNECT_TIMEOUT_MS=5000

# Public API rate limiting (defaults: 100 requests/minute per org)
# API_RATE_LIMIT=100
# API_RATE_WINDOW_MS=60000

# Canonical public app URL used for every outbound email link. HTTPS is
# required outside localhost. AUTH_URL and NEXT_PUBLIC_APP_URL remain
# compatibility fallbacks, but new deployments should set APP_URL.
# APP_URL=http://localhost:3000

# Email delivery (optional; Settings > Email reports unavailable until all
# three values are configured). EMAIL_FROM must be a sender verified by Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret for Resend delivery-status webhooks at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_SECRET=
# Set only after the corresponding deployed account-backed flow passes end-to-end validation.
TEAMS_NOTIFICATIONS_VALIDATED=false
TEAMS_COMMANDS_VALIDATED=false

# Optional always-on email worker base URL. Vercel uses the checked-in cron.
# EMAIL_WORKER_URL=https://your-app.example

# Slow-query threshold in ms — queries above this log a db.slow_query warning
# SLOW_QUERY_MS=500

# Bearer token for /api/cron/* — Vercel sends it automatically once set on the
# project. Unset, the review-cycle cron returns 503 instead of running.
CRON_SECRET=

# Playwright E2E auth bypass — LEAVE UNSET EVERYWHERE EXCEPT TEST RUNS.
# When set, a credentials provider is registered that signs in ANY user by
# email given this token. Setting it on a real deployment is a full auth
# bypass. Only `npm run test:e2e` and the CI e2e job should ever set it.
# E2E_AUTH_TOKEN=

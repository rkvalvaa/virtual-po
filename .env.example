# =============================================================================
# Virtual Product Owner — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Required variables are marked with (required).

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/vpo

# Auth.js v5 / NextAuth (required)
AUTH_SECRET=                    # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true

# OAuth Providers (at least one required)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic AI (required for agents)
ANTHROPIC_API_KEY=

# =============================================================================
# Integrations (all optional)
# =============================================================================

# Jira — Connect via Settings > Jira tab (credentials stored in DB)
# No env vars needed; configured through the UI.

# Linear — Connect via Settings > Linear tab (credentials stored in DB)
# No env vars needed; configured through the UI.

# GitHub Issues — Uses GitHub OAuth token from auth provider.
# No additional env vars needed; configured through the UI.

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=               # xoxb-... (from Slack app settings). App must have the users:read.email scope for approve/reject buttons.

# =============================================================================
# Optional Configuration
# =============================================================================

# Postgres pool, per function instance (defaults tuned for serverless)
# DB_POOL_MAX=5
# DB_POOL_IDLE_MS=10000
# DB_POOL_CONNECT_TIMEOUT_MS=5000

# Public API rate limiting (defaults: 100 requests/minute per org)
# API_RATE_LIMIT=100
# API_RATE_WINDOW_MS=60000

# App URL (for webhooks and callbacks)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slow-query threshold in ms — queries above this log a db.slow_query warning
# SLOW_QUERY_MS=500
